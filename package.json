{
  "name": "robot-agent-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "eval": "node scripts/run-ts.mjs src/eval/cli.ts --mode baseline",
    "eval:report": "node scripts/run-ts.mjs src/eval/cli.ts --mode baseline --write-report",
    "eval:replay": "node scripts/run-ts.mjs src/eval/cli.ts --mode replay",
    "eval:record": "node scripts/run-ts.mjs src/eval/cli.ts --mode record"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.10.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
