{
  "name": "robot-agent-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "eval": "node scripts/run-ts.mjs src/eval/cli.ts --mode baseline",
    "eval:report": "node scripts/run-ts.mjs src/eval/cli.ts --mode baseline --write-report",
    "eval:replay": "node scripts/run-ts.mjs src/eval/cli.ts --mode replay",
    "eval:record": "node scripts/run-ts.mjs src/eval/cli.ts --mode record"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.10.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
